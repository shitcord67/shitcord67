{
  "name": "discord-lookalike-flash",
  "version": "1.0.0",
  "description": "A lightweight Discord-style chat client prototype with local persistence.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:stack": "bash scripts/run-client-stack.sh",
    "electron": "electron electron/main.cjs",
    "electron:no-gateway": "ELECTRON_GATEWAY_MODE=off electron electron/main.cjs",
    "electron:with-gateway": "ELECTRON_GATEWAY_MODE=on electron electron/main.cjs",
    "build:platform": "bash scripts/build-platform.sh",
    "build:web": "bash scripts/build-platform.sh web --build",
    "build:electron": "bash scripts/build-platform.sh electron --build",
    "build:android": "bash scripts/build-platform.sh android --build",
    "build:webxdc": "node scripts/build-webxdc.mjs",
    "mobile:build:web": "node scripts/build-mobile-web.mjs",
    "mobile:android:patch-gradle": "node scripts/patch-capacitor-android-gradle.cjs",
    "mobile:cap:sync": "npm run mobile:build:web && npx cap sync",
    "mobile:android:init": "npm run mobile:build:web && npx cap add android && npm run mobile:android:patch-gradle",
    "mobile:android:sync": "npm run mobile:build:web && npx cap sync android && npm run mobile:android:patch-gradle",
    "mobile:android:open": "npm run mobile:android:sync && npx cap open android",
    "sync:xmpp-runtime": "node scripts/sync-strophe-runtime.mjs",
    "xmpp:auth-gateway": "node scripts/xmpp-auth-gateway.mjs",
    "postinstall": "node scripts/sync-strophe-runtime.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shitcord67/shitcord67.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shitcord67/shitcord67/issues"
  },
  "homepage": "https://github.com/shitcord67/shitcord67#readme",
  "dependencies": {
    "@capacitor/android": "^7.5.0",
    "@capacitor/cli": "^7.5.0",
    "@capacitor/core": "^7.5.0",
    "@capacitor/filesystem": "^7.0.0",
    "@xmpp/client": "^0.14.0",
    "@xmpp/debug": "^0.14.0",
    "strophe.js": "^1.6.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^35.0.0"
  }
}
